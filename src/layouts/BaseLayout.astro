---
import '../styles/global.css';
import { site } from '../config/site';
import { categories, categoryHref } from '../data/catalog';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; image?: string; }
const { title, description = site.description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const configuredGtm = import.meta.env.PUBLIC_WATER_HEATER_GTM_ID || '';
const gtmId = /^GTM-[A-Z0-9]+$/.test(configuredGtm) ? configuredGtm : '';
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#16365d"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="vi_VN"/><meta property="og:url" content={canonical.href}/>{image && <meta property="og:image" content={new URL(image, Astro.site).href}/>}<link rel="canonical" href={canonical.href}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{!site.readyToIndex && <meta name="robots" content="noindex,nofollow"/>}<title>{title}</title>
{gtmId && <script is:inline define:vars={{ gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);</script>}
</head><body>
{gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
<a class="skip-link" href="#main">Đến nội dung chính</a>
<div class="topbar"><div class="container topbar-inner"><span>Giải pháp nước nóng & thiết bị cho gia đình</span>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <a href="/kien-thuc/">Cẩm nang lựa chọn sản phẩm</a>}</div></div>
<header class="site-header"><div class="container header-main"><a class="brand" href="/" aria-label={`${site.shortBrand} – Trang chủ`}><span class="brand-symbol"><Icon name="water" size={29}/></span><span>{site.brand}<small>NƯỚC ẤM CHO TỔ ẤM</small></span></a><form class="header-search" action="/san-pham/" role="search"><label class="sr-only" for="header-query">Tìm sản phẩm</label><Icon name="search" size={20}/><input id="header-query" type="search" name="q" placeholder="Tìm sản phẩm, model, dung tích…"/><button type="submit">Tìm</button></form>{site.phone ? <a class="header-phone" href={`tel:${site.phone}`} data-track="click_phone"><Icon name="phone"/><span><small>LIÊN HỆ TƯ VẤN</small><strong>{site.phoneDisplay}</strong></span></a> : <a class="header-help" href="/lien-he/#tu-van"><Icon name="chat"/>Tư vấn chọn sản phẩm</a>}<button class="menu-toggle" id="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Mở menu"><Icon name="menu"/></button></div>
<nav class="main-nav" id="main-nav" aria-label="Điều hướng chính"><div class="container nav-inner"><a class:list={{ active: pathname === '/' }} href="/">Trang chủ</a><div class="nav-categories"><button class="category-toggle" type="button" aria-expanded="false" aria-controls="category-menu">Danh mục sản phẩm<svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="m5 7 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></button><div class="category-menu" id="category-menu" hidden>{categories.map(category=><a href={categoryHref(category)}>{category.name}</a>)}<a href="/san-pham/">Tất cả sản phẩm</a></div></div><a class:list={{ active: pathname.startsWith('/gioi-thieu') }} href="/gioi-thieu/">Giới thiệu</a><a class:list={{ active: pathname.startsWith('/kien-thuc') }} href="/kien-thuc/">Cẩm nang</a><a class:list={{ active: pathname.startsWith('/bao-hanh') }} href="/bao-hanh/">Bảo hành</a><a class:list={{ active: pathname.startsWith('/lien-he') }} href="/lien-he/">Liên hệ</a><a class="nav-cta" href="/lien-he/#tu-van">Đăng ký tư vấn</a></div></nav></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a class="brand light-brand" href="/"><span class="brand-symbol"><Icon name="water" size={28}/></span><span>{site.brand}<small>NƯỚC ẤM CHO TỔ ẤM</small></span></a><p>Khám phá thiết bị phù hợp với không gian sống. Bắt đầu từ nhu cầu sử dụng và những thông tin sản phẩm rõ ràng.</p>{site.company && <strong class="footer-company">{site.company}</strong>}{site.phone && <a class="footer-hotline" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>}</div><div><h2>Danh mục</h2>{categories.slice(0,7).map(category=><a href={categoryHref(category)}>{category.name}</a>)}</div><div><h2>Hỗ trợ khách hàng</h2><a href="/kien-thuc/">Cẩm nang lựa chọn</a><a href="/bao-hanh/">Thông tin bảo hành</a><a href="/giao-nhan/">Giao nhận & lắp đặt</a><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a><a href="/lien-he/">Liên hệ tư vấn</a></div><div><h2>Kết nối với chúng tôi</h2>{site.address && <p>{site.address}</p>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}{site.zalo && <a href={site.zalo} target="_blank" rel="noopener" data-track="click_zalo">Trao đổi qua Zalo</a>}<p>Gửi model sản phẩm và khu vực dự kiến lắp đặt để được trao đổi phương án phù hợp.</p><a class="footer-consult" href="/lien-he/#tu-van">Gửi yêu cầu tư vấn</a></div></div><div class="container footer-bottom"><span>© 2026 {site.company || site.shortBrand}</span><span>Giá và thông tin được xác nhận trong báo giá cho từng yêu cầu.</span></div></footer>
<div class="floating-contact">{site.zalo && <a href={site.zalo} target="_blank" rel="noopener" data-track="click_zalo"><Icon name="chat" size={20}/><span>Zalo</span></a>}{site.phone ? <a href={`tel:${site.phone}`} data-track="click_phone"><Icon name="phone" size={20}/><span>Gọi tư vấn</span></a> : <a href="/lien-he/#tu-van"><Icon name="chat" size={20}/><span>Nhận tư vấn</span></a>}</div>
<script>
  import { campaignForPage } from '../scripts/campaign';
  const menuButton=document.querySelector<HTMLButtonElement>('#menu-toggle');const menu=document.querySelector('#main-nav');
  menuButton?.addEventListener('click',()=>{const open=menuButton.getAttribute('aria-expanded')!=='true';menuButton.setAttribute('aria-expanded',String(open));menuButton.setAttribute('aria-label',open?'Đóng menu':'Mở menu');menu?.classList.toggle('is-open',open);});
  const categoryButton=document.querySelector<HTMLButtonElement>('.category-toggle');const categoryMenu=document.querySelector<HTMLElement>('#category-menu');
  const closeCategories=()=>{categoryButton?.setAttribute('aria-expanded','false');if(categoryMenu)categoryMenu.hidden=true;};
  categoryButton?.addEventListener('click',()=>{if(!categoryMenu)return;const open=categoryButton.getAttribute('aria-expanded')!=='true';categoryButton.setAttribute('aria-expanded',String(open));categoryMenu.hidden=!open;});
  document.addEventListener('click',event=>{if(!(event.target as Element)?.closest('.nav-categories'))closeCategories();});document.addEventListener('keydown',event=>{if(event.key==='Escape'){closeCategories();menuButton?.setAttribute('aria-expanded','false');menuButton?.setAttribute('aria-label','Mở menu');menu?.classList.remove('is-open');}});
  document.querySelectorAll<HTMLAnchorElement>('[data-track]').forEach(link=>link.addEventListener('click',()=>{const w=window as Window&{dataLayer?:Record<string,unknown>[]};(w.dataLayer||=[]).push({event:link.dataset.track,page_path:location.pathname,site_type:'water_heater'});}));
  try{const previous=JSON.parse(sessionStorage.getItem('water_heater_campaign')||'{}');const campaign=campaignForPage(location.search,previous);sessionStorage.setItem('water_heater_campaign',JSON.stringify(campaign));}catch{/* Storage can be unavailable. */}
</script>
</body></html>
