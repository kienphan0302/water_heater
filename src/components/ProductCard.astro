---
import type { Product } from '../data/catalog';
import { productHref, productImage, productPrice, money, categoryName, normalizeSearch } from '../data/catalog';
interface Props { product: Product; eager?: boolean; }
const { product, eager = false } = Astro.props;
const onSale = product.price !== null && product.price > 0 && !!product.regularPrice && product.regularPrice > product.price;
const categoryKeys = [product.categoryKey, ...product.categories.map(category => category.key)].join(' ');
---
<article class="product-card" data-product-card data-category={categoryKeys} data-price={product.price || ''} data-brand={product.brand || ''} data-search={normalizeSearch([product.name, product.brand, ...product.specs.map(spec => spec.value)].filter(Boolean).join(' '))} data-name={product.name}>
  <a class="product-image" href={productHref(product)} aria-label={`Xem ${product.name}`}>
    {onSale && <span class="sale-badge">Giá ưu đãi</span>}
    <img src={productImage(product)} alt={product.images[0]?.alt || product.name} width="480" height="480" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <div class="product-body">
    <p class="product-category">{categoryName(product.categoryKey)}</p>
    <h3><a href={productHref(product)}>{product.name}</a></h3>
    <div class="product-price-row"><strong>{productPrice(product)}</strong>{onSale && <del>{money(product.regularPrice!)}</del>}</div>
    <div class="product-card-actions"><a class="text-link" href={productHref(product)}>Chi tiết</a><a class="mini-button" href={`${productHref(product)}#tu-van`}>Nhận tư vấn</a></div>
  </div>
</article>
