---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import Consultation from '../components/Consultation.astro';
import { products, categories, productImage, categoryHref, productHref, productsInCategory, categoryIcon, productPrice } from '../data/catalog';
import { articles } from '../data/articles';
import { site } from '../config/site';
import banner from '../config/banner.json';
const waterHeaters=products.filter(product=>product.categoryKey==='may-nuoc-nong');
const heroProduct=waterHeaters.find(product=>product.images.some(image=>image.localPath==='/images/catalog/6cab06d8a726da61.webp'))||waterHeaters.find(product=>product.images.length>0)||products[0];
const featured=waterHeaters.slice(0,8);
const otherFeatured=categories.filter(category=>category.key!=='may-nuoc-nong').map(category=>productsInCategory(category.key)[0]).filter(Boolean).slice(0,4);
---
<BaseLayout title={banner.seoTitle} description={banner.seoDescription || site.description} image={banner.image || (heroProduct ? productImage(heroProduct) : undefined)}>
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{banner.eyebrow}</p><h1>{banner.heading}<br/><em>{banner.accent}</em></h1><p class="hero-description">{banner.description}</p><div class="hero-actions"><a class="button" href="/danh-muc/may-nuoc-nong/">{banner.primaryLabel}</a><a class="button button-outline" href="#tu-van">{banner.secondaryLabel}</a></div><div class="hero-details"><span><Icon name="check" size={17}/>Thông số theo từng model</span><span><Icon name="check" size={17}/>Trao đổi trước khi lựa chọn</span></div></div><div class="hero-visual"><div class="hero-visual-title"><span>GIẢI PHÁP NƯỚC NÓNG</span><strong>Cho ngôi nhà của bạn</strong></div>{banner.image ? <div class="hero-product"><img src={banner.image} alt={banner.imageAlt || banner.heading} width="650" height="540" loading="eager" fetchpriority="high" style="mix-blend-mode:normal;filter:none;object-fit:contain"/></div> : heroProduct && <a class="hero-product" href={productHref(heroProduct)}><img src={productImage(heroProduct)} alt={heroProduct.name} width="650" height="540" loading="eager" fetchpriority="high"/><span class="hero-product-caption"><strong>{heroProduct.name}</strong><span>{productPrice(heroProduct)}</span></span></a>}<div class="hero-roundel" aria-hidden="true"><Icon name="sun" size={28}/><span>TẬN DỤNG<br/>NĂNG LƯỢNG NẮNG</span></div></div></div></section>
<div class="benefits-strip"><div class="container benefits-grid">{[['search','Khám phá đầy đủ','Danh mục theo nhu cầu'],['book','Thông tin rõ ràng','Đối chiếu từng model'],['chat','Trao đổi trực tiếp','Gửi yêu cầu tư vấn'],['shield','Chú trọng sau mua','Tìm hiểu bảo hành']].map(([icon,title,text])=><div><Icon name={icon} size={27}/><span><strong>{title}</strong><small>{text}</small></span></div>)}</div></div>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">DANH MỤC SẢN PHẨM</p><h2>Chọn theo nhu cầu của bạn.</h2></div><a class="text-link" href="/san-pham/">Xem toàn bộ {products.length} sản phẩm</a></div><div class="category-grid">{categories.map(category=>{const items=productsInCategory(category.key);return <a class:list={['category-tile',{'category-tile-featured':category.key==='may-nuoc-nong'}]} href={categoryHref(category)}><div><span class="category-icon"><Icon name={categoryIcon(category)} size={25}/></span><h3>{category.name}</h3><p>{items.length} sản phẩm</p></div>{items[0]&&<img src={productImage(items[0])} alt="" width="230" height="220" loading="lazy"/>}</a>;})}</div></section>
<section class="section product-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">GIẢI PHÁP NƯỚC NÓNG</p><h2>Khám phá những lựa chọn<br/>cho gia đình.</h2></div><div class="heading-copy"><p>Từ dung tích đến cấu hình, mỗi model có những thông số riêng để bạn cân nhắc.</p><a class="text-link" href="/danh-muc/may-nuoc-nong/">Xem máy nước nóng</a></div></div><div class="product-grid">{featured.map(product=><ProductCard product={product}/>)}</div><p class="catalog-note">Giá tham khảo theo dữ liệu danh mục ngày {site.catalogDate}. Vui lòng xác nhận giá, phụ kiện và chi phí lắp đặt trong báo giá.</p></div></section>
<section class="section container choice-grid"><div class="choice-art"><div class="choice-art-icon"><Icon name="water" size={84}/></div><p>MỖI KHÔNG GIAN<br/><strong>MỘT LỰA CHỌN PHÙ HỢP.</strong></p><span class="choice-art-label">Từ thiết bị đến trải nghiệm sử dụng</span></div><div class="choice-copy"><p class="eyebrow">ĐỒNG HÀNH CÙNG LỰA CHỌN CỦA BẠN</p><h2>Hiểu rõ nhu cầu.<br/>Chọn thiết bị phù hợp.</h2><p>Thông tin sản phẩm là điểm khởi đầu. Vị trí lắp đặt, thói quen sử dụng và phạm vi cung cấp giúp hoàn thiện phương án dành cho ngôi nhà của bạn.</p><ul class="check-list"><li><Icon name="check"/>So sánh tên model, dung tích và kích thước</li><li><Icon name="check"/>Trao đổi điều kiện lắp đặt thực tế</li><li><Icon name="check"/>Xác nhận giá và chính sách theo sản phẩm</li></ul><a class="button button-outline" href="/gioi-thieu/">Tìm hiểu thêm</a></div></section>
{otherFeatured.length>0&&<section class="section companion-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THÊM TIỆN NGHI CHO NGÔI NHÀ</p><h2>Khám phá các nhóm thiết bị.</h2></div><a class="text-link" href="/san-pham/">Xem danh mục sản phẩm</a></div><div class="product-grid">{otherFeatured.map(product=><ProductCard product={product}/>)}</div></div></section>}
<section class="section container"><div class="section-heading"><div><p class="eyebrow">CẨM NANG LỰA CHỌN</p><h2>Hiểu rõ trước khi quyết định.</h2></div><a class="text-link" href="/kien-thuc/">Xem cẩm nang</a></div><div class="guide-grid">{articles.map(article=><a class="guide-card" href={`/kien-thuc/${article.slug}/`}><span class="guide-icon"><Icon name={article.icon} size={29}/></span><p class="eyebrow">{article.eyebrow}</p><h3>{article.title}</h3><p>{article.excerpt}</p><span class="text-link">Đọc bài viết</span></a>)}</div></section>
<section class="faq-section section"><div class="container faq-grid"><div><p class="eyebrow">GIẢI ĐÁP THẮC MẮC</p><h2>Những điều bạn<br/>có thể đang quan tâm.</h2><p>Trao đổi thêm với chúng tôi nếu bạn cần thông tin cho một model cụ thể.</p><a class="text-link" href="/lien-he/#tu-van">Gửi câu hỏi của bạn</a></div><div class="faq-list"><details><summary>Nên bắt đầu chọn máy nước nóng từ đâu?</summary><p>Hãy chuẩn bị nhu cầu sử dụng, khu vực lắp đặt và các model đang cân nhắc. Đối chiếu dung tích, kích thước và điều kiện kỹ thuật của từng sản phẩm trước khi lựa chọn.</p></details><details><summary>Giá trên website đã gồm chi phí lắp đặt chưa?</summary><p>Giá hiển thị là giá tham khảo trong danh mục. Phạm vi thiết bị, phụ kiện, vận chuyển và lắp đặt cần được xác nhận trong báo giá cho từng yêu cầu.</p></details><details><summary>Vì sao một số sản phẩm hiển thị “Liên hệ”?</summary><p>Một số model cần xác nhận phiên bản và giá tại thời điểm tư vấn. Bạn có thể gửi yêu cầu trực tiếp từ trang sản phẩm để trao đổi đúng model.</p></details><details><summary>Chính sách bảo hành áp dụng như thế nào?</summary><p>Chính sách phụ thuộc model, bộ phận, nhà sản xuất và chứng từ cung cấp. Hãy xác nhận nội dung cụ thể trong báo giá và hồ sơ bàn giao.</p></details></div></div></section>
<Consultation/>
</BaseLayout>
