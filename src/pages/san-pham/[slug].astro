---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import Consultation from '../../components/Consultation.astro';
import { products, productImage, productImages, productPrice, productHref, categoryName, categoryHref, money, type Product } from '../../data/catalog';
import { site } from '../../config/site';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props as {product:Product};
const gallery=productImages(product);
const related=products.filter(item=>item.id!==product.id&&item.categoryKey===product.categoryKey).slice(0,4);
const highlights=product.specs.filter(spec=>/model|dung tích|h[uã]ng|bảo hành/i.test(spec.label)).slice(0,3);
const schema={'@context':'https://schema.org','@type':'Product',name:product.name,sku:String(product.id),description:product.summary,image:gallery.map(image=>new URL(image.localPath,Astro.site).href),...(product.brand?{brand:{'@type':'Brand',name:product.brand}}:{}),...(product.price&&product.price>0?{offers:{'@type':'Offer',price:product.price,priceCurrency:'VND',url:new URL(productHref(product),Astro.site).href}}:{})};
---
<BaseLayout title={`${product.name} | ${site.shortBrand}`} description={product.summary||`${product.name}: xem hình ảnh, giá tham khảo và thông số sản phẩm.`} image={productImage(product)}>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
<section class="section container product-detail"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href={categoryHref(product.categoryKey)}>{categoryName(product.categoryKey)}</a><span aria-hidden="true">/</span><span>{product.name}</span></nav><div class="detail-grid"><div class="product-gallery"><div class="gallery-main"><img id="product-main-image" src={productImage(product)} alt={gallery[0]?.alt||product.name} width="700" height="700" loading="eager" fetchpriority="high"/></div>{gallery.length>1&&<div class="gallery-thumbs" aria-label="Ảnh sản phẩm">{gallery.map((image,index)=><button type="button" data-gallery-src={image.localPath} data-gallery-alt={image.alt} aria-label={`Xem ảnh ${index+1} của ${product.name}`} aria-pressed={index===0}><img src={image.localPath} alt="" width="80" height="80" loading="lazy"/></button>)}</div>}</div><div class="detail-copy"><p class="eyebrow">{product.brand||categoryName(product.categoryKey)}</p><h1>{product.name}</h1><p class="detail-summary">{product.summary}</p><div class="detail-price-box"><span>Giá tham khảo</span><strong>{productPrice(product)}</strong>{product.price&&product.regularPrice&&product.regularPrice>product.price?<del>{money(product.regularPrice)}</del>:null}<small>Vui lòng xác nhận giá và các hạng mục đi kèm khi nhận tư vấn.</small></div>{highlights.length>0&&<ul class="detail-highlights">{highlights.map(spec=><li>{spec.label}: {spec.value}</li>)}</ul>}<div class="detail-actions"><a class="button" href="#tu-van">Nhận tư vấn sản phẩm</a>{site.phone&&<a class="button button-outline" href={`tel:${site.phone}`} data-track="click_phone">Gọi tư vấn</a>}</div><p class="detail-small-note">Thông tin tham khảo trong danh mục ngày {site.catalogDate}. Kiểm tra đúng model và phiên bản trước khi lựa chọn.</p></div></div><div class="detail-content"><div><h2>Thông số sản phẩm</h2>{product.specs.length>0?<table class="spec-table"><tbody>{product.specs.map(spec=><tr><th scope="row">{spec.label}</th><td>{spec.value}</td></tr>)}</tbody></table>:<p>Thông số chi tiết cần được xác nhận theo model. Gửi yêu cầu để trao đổi thêm trước khi lựa chọn.</p>}<div class="detail-description"><h2>Trước khi đặt sản phẩm</h2><p>Đối chiếu model, kích thước và nhu cầu sử dụng. Phạm vi phụ kiện, giao nhận, lắp đặt và điều kiện bảo hành được xác nhận theo báo giá và tài liệu cung cấp cho từng sản phẩm.</p></div></div><aside class="detail-help"><Icon name="chat" size={29}/><h3>Cần trao đổi thêm?</h3><p>Chuẩn bị ảnh vị trí lắp đặt, khu vực công trình và những thông tin bạn muốn làm rõ về sản phẩm.</p><a class="text-link" href="#tu-van">Gửi yêu cầu cho model này</a></aside></div></section>
{related.length>0&&<section class="section related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THÊM LỰA CHỌN ĐỂ CÂN NHẮC</p><h2>Sản phẩm cùng nhóm.</h2></div><a class="text-link" href={categoryHref(product.categoryKey)}>Xem toàn bộ danh mục</a></div><div class="product-grid">{related.map(item=><ProductCard product={item}/>)}</div></div></section>}
<Consultation product={product}/>
<script>
  const main=document.querySelector<HTMLImageElement>('#product-main-image');const thumbnails=document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]');
  for(const button of thumbnails)button.addEventListener('click',()=>{if(!main||!button.dataset.gallerySrc)return;main.src=button.dataset.gallerySrc;main.alt=button.dataset.galleryAlt||main.alt;for(const item of thumbnails)item.setAttribute('aria-pressed',String(item===button));});
</script>
</BaseLayout>
