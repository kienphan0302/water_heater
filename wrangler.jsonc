{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "water-heater",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "water-heater-leads"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [{ "binding": "DB", "database_name": "water-heater-leads-preview" }]
    }
  }
}
